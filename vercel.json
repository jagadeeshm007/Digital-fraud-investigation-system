{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,tests/**,aidlc/**,scripts/**,.claude/**,.github/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|mcp|healthz|docs|redoc|openapi.json|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
