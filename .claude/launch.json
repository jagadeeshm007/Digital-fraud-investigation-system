{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dfis",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "SERVE_FRONTEND=1 exec .venv/bin/uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
