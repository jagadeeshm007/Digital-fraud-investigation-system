# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase pooler URL (Supabase → Connect). Username must be postgres.<project-ref>.
#   Session pooler     : port 5432 (recommended for this app)
#   Transaction pooler : port 6543 (works; the app turns off asyncpg's statement cache)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Local alternative (docker compose / tests):
# DATABASE_URL=postgresql+asyncpg://dfis:dfis_local@localhost:5432/dfis

# ── Security ──────────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes): python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it changes every masked token shown in the UI, AI log and MCP.
MASKING_HMAC_KEY=replace_with_64_hex_chars

# ── AI review (Groq) ──────────────────────────────────────────────────────────
# Key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Primary model; falls back to openai/gpt-oss-20b on rate limit
GROQ_MODEL=openai/gpt-oss-120b
# 1 = deterministic stub, no real AI calls (CI, offline demo)
FAKE_LLM=0
# Hard cap on estimated AI spend in USD; once reached, reviews stop and the rule-based score stands
AI_BUDGET_USD=10
# Alerts reviewed by AI in the background after each detection run
AI_REVIEW_BATCH=25

# ── MCP server (/mcp — Claude, ChatGPT, Gemini) ──────────────────────────────
# Host headers allowed on /mcp besides localhost, comma-separated. Set this to the
# deployed host (e.g. dfis-gray.vercel.app), or remote MCP clients are rejected.
MCP_ALLOWED_HOSTS=dfis-gray.vercel.app
# Extra Origin headers to allow on /mcp, comma-separated.
# ChatGPT.com sends requests from its backend with Origin: https://chatgpt.com.
MCP_ALLOWED_ORIGINS=https://chatgpt.com
# 1 = no in-memory sessions (required on Vercel serverless — each request may hit a fresh instance)
MCP_STATELESS=1

# ── Server ────────────────────────────────────────────────────────────────────
# 1 = serve the built React app from frontend/dist (the Docker image sets this)
SERVE_FRONTEND=0
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO
# Port for uvicorn in the Docker image; managed hosts usually set this themselves
# PORT=8000
