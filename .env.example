# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Session Pooler URL (copy from Supabase → Connect → Session Pooler)
# Username must be postgres.<project-ref> when using the pooler
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Security ──────────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes) — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
MASKING_HMAC_KEY=replace_with_64_hex_chars

# ── AI Review (Groq) ──────────────────────────────────────────────────────────
# Get key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Primary model — falls back to llama-3.1-8b-instant on rate limit
GROQ_MODEL=llama-3.3-70b-versatile
# Set to 1 in CI / offline demo to skip real AI calls
FAKE_LLM=0

# ── Server ────────────────────────────────────────────────────────────────────
# Set to 1 to serve the built React frontend from /frontend/dist
SERVE_FRONTEND=0
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO
